# Backend environment variables. Copy to backend/.env and fill in.
# These are SECRET and must never be exposed to the React app.

# Supabase project (same URL and anon key as the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only needed for system-level writes (later phases). Keep server-side only.
SUPABASE_SERVICE_KEY=

# Allowed browser origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# AI provider (used from Phase 4)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
# Stay below your model's requests-per-minute limit (Flash-Lite free tier: 15)
AI_REQUESTS_PER_MINUTE=12
