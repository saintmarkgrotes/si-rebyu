# Frontend (Vite) environment variables.
# Copy to .env.local and fill in. Anything prefixed VITE_ is bundled into the
# browser app and is PUBLIC -- never put secrets here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Leave empty in local dev (Vite proxies /api to http://localhost:8000).
# In production, set to the deployed backend origin, e.g. https://si-rebyu-api.onrender.com
VITE_API_URL=

# Optional. Enables "Import from Google Drive" on the Documents page. Leave all three
# empty to hide the button. These are public identifiers (restrict them by HTTP referrer
# in Google Cloud); see DEPLOYMENT.md for setup.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=