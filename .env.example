# Frontend (Vite) environment variables.
# Copy to .env.local and fill in. Anything prefixed VITE_ is bundled into the
# browser app and is PUBLIC -- never put secrets here.

VITE_SUPABASE_URL=https://lnnuebddomcalkkbtitj.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. Leave empty in local dev (Vite proxies /api to http://localhost:8000).
# In production, set to the deployed backend origin, e.g. https://si-rebyu-api.onrender.com
VITE_API_URL=
